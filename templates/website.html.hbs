<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{db.websites_with_clicks.0.name}} - Proxy List provided by Knaben Database</title>
    <link rel="icon" href="/favicon.ico">
    <meta name="description" content="A list of proxies for {{db.websites_with_clicks.0.name}}. {{db.websites_with_clicks.0.description}}">
    <meta name="keywords" content="{{lowercase db.websites_with_clicks.0.name}}, proxy, list, workaround, bypass, working, free, knaben"/>
    <link rel="stylesheet" href="/static/css/style.css?v={{style_version}}">
    <script src="/static/js/bootstrap.bundle.min.js"></script>
    <script src="/static/js/main.js?v={{main_js_version}}"></script>
</head>
<body>
<div class="container-lg m-auto mt-5 position-relative">
    <a href="/" class="mt-5 fancy-link d-grid text-decoration-none text-darkblue">
        {{#with logo}}
        <div style="height: 80px;width: 80px;">
            {{> partials/logo}}
        </div>
        <div class="text-center">Head back</div>
        {{/with}}
    </a>
    {{#with db.websites_with_clicks.[0]}}
    <div class="bg-darkblue bg-opacity-75 p-3 mx-auto mt-5 position-relative">
        <div class="m-auto text-center text-pink mt-2 fs-0">{{name}}</div>
        <div class="m-auto text-center text-pink text-opacity-75" data-bs-toggle="tooltip" title="{{pretty_date last_checked}}">{{updated_time last_checked}}</div>
        <i class="m-auto text-center text-pink d-block text-opacity-50">Proxy List provided by Knaben Database</i>
        <div class="d-flex justify-content-center position-absolute p-3 top-0 end-0">
            <div class="text-highlight mx-2 d-flex" data-bs-toggle="tooltip" title='Proxies and websites with this color are confirmed to be working'><div class="bg-highlight align-self-center me-1" style="height: 10px;width:10px"></div> Working</div>
            <div class="text-white mx-2 d-flex" data-bs-toggle="tooltip" title='Checking towards websites and proxies with this color may have been blocked. 403 Forbidden return code.'><div class="bg-white align-self-center me-1" style="height: 10px;width:10px"></div> Most likely working</div>
            <div class="text-red mx-2 d-flex" data-bs-toggle="tooltip" title='Check towards proxy or website failed'><div class="bg-red align-self-center me-1" style="height: 10px;width:10px"></div> It's down</div>
        </div>
        <hr class="mx-5 text-white"/>
        <div>
            <p class="text-white mb-0">{{description}}</p>
            <div class="d-flex w-100">
                <div class="w-100 d-grid">
                    <div class="fancy-link z-2 {{#if is_restricted}}text-white{{else}}{{#unless up}}text-red{{/unless}}{{/if}}">
                        <a title="The official link" href="{{url}}">{{url}}</a>
                    </div>
                    {{#unless up}}
                        {{#unless is_restricted}}
                            <div>
                                <i class="text-white text-opacity-50">{{#if test_reason}}{{test_reason}}{{else}}Down{{/if}}</i>
                            </div>
                        {{/unless}}
                    {{/unless}}
                </div>
                <div style="color: {{colors_between "#FFFFFF" "#FF0000" ping 0.3 6.0 0.8}}" class="d-inline-flex ms-auto">Ping:&nbsp;{{multiply ping 1000 round=true}}ms</div>
            </div>
        </div>
        <div class="d-flex flex-wrap">
            {{#each categories}}
                <div class="fs-7 px-2 me-2 mb-2 bg-white text-pink bg-opacity-25">{{ this }}</div>
            {{/each}}
        </div>
    {{/with}}
        <table class="mt-2 w-100 text-nowrap">
            <colgroup>
                <col style="width: auto">
                <col style="width: 100%;">
                <col style="width: 76px;">
                <col style="width: 55px;">
                <col style="width: 47px;">
            </colgroup>
            <thead>
            <tr class="text-pink bg-white bg-opacity-25">
                <th class="px-2">Link</th>
                <th class="px-2 w-min">Info</th>
                <th class="px-2 text-center w-min">Clicks 24h</th>
                <th class="px-2 text-center w-min">Clicks</th>
                <th class="px-2 text-center w-min">Ping</th>
            </tr>
            </thead>
            <tbody>
            {{#each db.proxies_with_clicks}}
                <tr class="{{#unless @first}}border-top border-white border-opacity-25{{/unless}}">
                    <th class="px-2">
                        <div class="position-relative">
                            <div class="fancy-link mw-100 text-overflow-ellipsis {{#if is_restricted}}text-white{{else}}{{#unless up}}text-red{{/unless}}{{/if}}" title="{{url}}">
                                <a href="{{url}}" class="proxy-link" data-proxy-id="{{id}}">{{url}}</a>
                            </div>
                            {{#if (contains url "knaben")}}
                                <div class="position-absolute end-100 top-0 text-highlight" data-bs-toggle="tooltip" aria-label="Knaben's proxy" data-bs-original-title="Knaben's proxy">
                                    <!-- If you are wondering, I did indeed edit this SVG manually -->
                                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="11" viewBox="300 210 200 430">
                                        <g id="#00002aff">
                                            <path fill="currentcolor" opacity="1.00" d=" M 282.86 294.84 C 331.85 248.96 409.22 237.80 469.25 267.80 C 526.20 294.69 564.83 355.91 563.90 418.98 C 527.25 418.97 490.73 431.31 461.71 453.72 C 420.72 484.78 395.73 535.48 395.97 586.90 C 328.47 588.02 263.46 543.46 239.62 480.39 C 213.91 417.40 231.95 339.96 282.86 294.84 Z"></path>
                                        </g>
                                        <g id="#00ff72ff">
                                            <path fill="currentcolor" opacity="1.00" d=" M 461.71 453.72 C 490.73 431.31 527.25 418.97 563.90 418.98 C 564.73 462.13 546.83 505.00 516.90 535.92 C 485.71 568.25 441.02 587.76 395.97 586.90 C 395.73 535.48 420.72 484.78 461.71 453.72 Z"></path>
                                        </g>
                                    </svg>
                                </div>
                            {{/if}}
                            {{#if official}}
                                <div class="position-absolute end-100 top-0 text-pink"  data-bs-toggle="tooltip" title='This is a confirmed official proxy'>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-check" viewBox="0 0 16 16">
                                        <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425a.267.267 0 0 1 .02-.022z"/>
                                    </svg>
                                </div>
                            {{/if}}
                        </div>
                    </th>
                    <th class="text-white text-opacity-50 w-min px-2" style="white-space: pre-wrap">{{#if test_reason}}{{test_reason}}{{/if}}</th>
                    <th class="text-center text-white text-opacity-50 w-min px-2">{{clicks_last_24h}}</th>
                    <th class="text-center text-white text-opacity-50 w-min px-2">{{clicks}}</th>
                    <th style="color: {{colors_between "#FFFFFF" "#FF0000" ping 0.3 6.0 0.8}}" class="text-center w-min">{{multiply ping 1000 round=true}}ms</th>
                </tr>
            {{/each}}
            </tbody>
        </table>
    </div>
    {{#if db.websites_with_clicks.0.comments}}
        <br/>
        <h3 class="text-opacity-50 text-darkblue">Comments</h3>
        <div class="p-2 bg-darkblue bg-opacity-25">
            {{#each db.websites_with_clicks.0.comments}}
            <div class="d-flex">
                <div class="text-pink px-2 text-opacity-100">{{identifier}}</div>
                <div class="text-white">{{content}}</div>
                <div class="text-white text-opacity-50 ms-auto">{{pretty_date time}}</div>
            </div>
            {{/each}}
        </div>
    {{/if}}
</div>
{{> partials/footer}}
</body>
</html>