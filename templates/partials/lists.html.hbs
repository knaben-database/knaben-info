{{#each db.websites_with_clicks}}
    <div class="bg-darkblue bg-opacity-75 p-3 mx-2 my-4 position-relative proxyBox">
        <div>
            <div class="d-flex w-100">
                <div class="w-100 d-grid">
                    <div class="fancy-link z-2 {{#if is_restricted}}text-white{{else}}{{#unless up}}text-red{{/unless}}{{/if}}">
                        <a title="The official link" href="{{url}}">{{url}}</a>
                    </div>
                    {{#unless up}}
                        {{#unless is_restricted}}
                        <div>
                            <i class="text-white text-opacity-50">{{#if test_reason}}{{test_reason}}{{else}}Down{{/if}}</i>
                        </div>
                        {{/unless}}
                    {{/unless}}
                </div>
                <div style="color: {{colors_between_offset_ease_out "#FFFFFF" "#FF0000" 0.3 6.0 ping 0.8}}" class="d-inline-flex ms-auto">Ping:&nbsp;{{multiply_by_thousand_and_round ping}}ms</div>
            </div>
            <h1 class="text-white mb-0 fancy-link">
                <a title="More info" href="/website/{{name_to_safe_clickable name}}">{{name}}</a>
            </h1>
        </div>
        <div class="d-flex flex-wrap">
            {{#each categories}}
                <div class="fs-7 px-2 me-2 mb-2 bg-white text-pink bg-opacity-25">{{ this }}</div>
            {{/each}}
        </div>
        {{#if proxy_list}}
        <table class="mt-2 w-100 text-nowrap" style="table-layout: fixed">
            <colgroup>
                <col style="width: auto">
                <col style="width: 76px;">
                <col style="width: 55px;">
                <col style="width: 47px;">
            </colgroup>
            <thead>
            <tr class="text-pink bg-white bg-opacity-25">
                <th class="px-2">Link</th>
                <th class="px-2 text-center w-min">Clicks 24h</th>
                <th class="px-2 text-center w-min">Clicks</th>
                <th class="px-2 text-center w-min">Ping</th>
            </tr>
            </thead>
            <tbody>
            {{#each proxy_list}}
                <tr class="{{#unless @first}}border-top border-white border-opacity-25{{/unless}}">
                    <th>
                        <div class="position-relative">
                            <div class="fancy-link mw-100 text-overflow-ellipsis {{#if is_restricted}}text-white{{/if}}" title="{{url}}">
                                <a href="{{url}}" class="proxy-link" data-proxy-id="{{id}}">{{url}}</a>
                            </div>
                            {{#if official}}
                                <div class="position-absolute end-100 top-0 text-pink"  data-bs-toggle="tooltip" title='This is a confirmed official proxy'>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-check" viewBox="0 0 16 16">
                                        <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425a.267.267 0 0 1 .02-.022z"/>
                                    </svg>
                                </div>
                            {{/if}}
                        </div>
                    </th>
                    <th class="text-center text-white text-opacity-50 w-min">{{clicks_last_24h}}</th>
                    <th class="text-center text-white text-opacity-50 w-min">{{clicks}}</th>
                    <th style="color: {{colors_between_offset_ease_out "#FFFFFF" "#FF0000" 0.3 6.0 ping 0.8}}" class="text-center w-min">{{multiply_by_thousand_and_round ping}}ms</th>
                </tr>
            {{/each}}
            </tbody>
        </table>
        {{else}}
            <i class="p-2 text-white d-block text-center text-opacity-50">No proxies are working?</i>
        {{/if}}
    </div>
{{/each}}
